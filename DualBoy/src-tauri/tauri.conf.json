{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dualboy",
  "version": "0.2.0-alpha.1",
  "identifier": "com.coreyb.dualboy",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node -e \"const fs=require('fs'),p=require('path');let d=process.cwd();for(;;){if(fs.existsSync(p.join(d,'src-tauri','tauri.conf.json'))){for(const f of ['dualboy-web.js','dualboy-web.wasm','dualboy-web-dbg.js','dualboy-web-dbg.wasm']){try{fs.unlinkSync(p.join(d,'src',f))}catch(e){}}break}const up=p.dirname(d);if(up===d)break;d=up}\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dualboy",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0.1"
      }
    }
  }
}

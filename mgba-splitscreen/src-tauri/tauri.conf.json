{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mgba-splitscreen",
  "version": "0.3.0",
  "identifier": "com.coreyb.mgbasplitscreen",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run strip-web-engine"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mgba-splitscreen",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.3.0.0"
      }
    }
  }
}
